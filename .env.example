# ── Environment configuration for Aditya-L1 Flare System ──────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Paths ───────────────────────────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_CATALOGUES_DIR=data/catalogues

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/flare_system.db

# ─── Ingestion ───────────────────────────────────────────────────────────────
# Common resampling cadence in seconds (0 = use coarsest native cadence)
RESAMPLE_CADENCE_S=1

# ─── Nowcasting thresholds (Phase 3) ─────────────────────────────────────────
SIGMA_THRESHOLD=5.0
COINCIDENCE_WINDOW_S=120

# ─── Forecasting (Phase 4) ───────────────────────────────────────────────────
FORECAST_HORIZON_MIN=30
SEQUENCE_WINDOW_MIN=60

# ─── API (Phase 5) ───────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
STREAM_PLAYBACK_SPEED=1.0
OPENAI_API_KEY=your_openrouter_api_key_here

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── External APIs ───────────────────────────────────────────────────────────
NASA_API_KEY=your_nasa_api_key_here
